{
  "name": "@nsyan/db",
  "version": "1.1.0",
  "description": "AI 接入数据库扩展 —— 五大家族方言架构，支持 PostgreSQL/MySQL/Oracle/达梦/Redis/Elasticsearch/MongoDB/Hive/Spark 九种数据库，提供查询/表结构/扫描建连/连接清单工具给 LLM",
  "keywords": [
    "pi-extension",
    "pi-package",
    "database",
    "postgresql",
    "mysql",
    "oracle",
    "dameng",
    "dm",
    "redis",
    "elasticsearch",
    "mongodb",
    "mongo",
    "hive",
    "spark"
  ],
  "license": "MIT",
  "main": "index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "files": [
    "index.ts",
    "src/",
    "README.md"
  ],
  "exports": {
    ".": "./index.ts",
    "./core": "./src/core/index.ts",
    "./dialects": "./src/dialects/index.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "dmdb": "^1.0.52452",
    "es7": "npm:@elastic/elasticsearch@7",
    "hive-driver": "^1.0.1",
    "ioredis": "^6.0.0",
    "mongodb": "^6.21.0",
    "mysql2": "^3.23.1",
    "oracledb": "^7.0.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.13"
  },
  "scripts": {
    "test": "tsx --test \"test/**/*.test.ts\""
  }
}
