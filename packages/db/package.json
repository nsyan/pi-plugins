    "mongodb": "^6.21.0",
    "mysql2": "^3.23.1",
    "neo4j-driver": "^5.28.3",
    "oracledb": "^7.0.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.typecheck.json"
